{
  "name": "@sharedid-edge/modules",
  "version": "0.1.0",
  "description": "The SharedID Edge built-in module list (ip, ec, geo, reflect, ua) that every adapter bundles",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/module-ec": "0.1.0",
    "@sharedid-edge/module-geo": "0.1.0",
    "@sharedid-edge/module-ip": "0.1.0",
    "@sharedid-edge/module-reflect": "0.1.0",
    "@sharedid-edge/module-ua": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patmmccann/sharedid-edge.git",
    "directory": "packages/modules/all"
  }
}
