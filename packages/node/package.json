{
  "name": "@sharedid-edge/node",
  "version": "0.1.0",
  "description": "Run SharedID Edge as a Node.js HTTP server, for local development, self-hosting and the conformance suite",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sharedid-edge-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/module-ec": "0.1.0",
    "@sharedid-edge/module-geo": "0.1.0",
    "@sharedid-edge/module-ip": "0.1.0",
    "@sharedid-edge/module-reflect": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patmmccann/sharedid-edge.git",
    "directory": "packages/node"
  }
}
