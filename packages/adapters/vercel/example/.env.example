# SharedID Edge settings. On Vercel, set them as environment variables (Project Settings → Environment Variables,
# or `vercel env add`); locally, copy this file to .env.local. Empty means the default. Full reference:
# https://github.com/patmmccann/sharedid-edge#configuration-reference
SID_BASE_PATH=
SID_COOKIE_NAME=
# Required: the domain Prebid.js writes _pubcid on, normally your registrable domain (or host-only).
SID_COOKIE_DOMAIN=example.com
SID_MAX_AGE_DAYS=
SID_CREATE=
SID_RECOVERY_COOKIE=
SID_OPTOUT_COOKIE=
SID_VENDOR_ID=
SID_ALLOWED_ORIGINS=
SID_SYNC_CACHE_SECONDS=
SID_MODULES=
SID_SYNC_MODULES=
SID_MODULE_CONFIG=
SID_MODULE_TIMEOUT_MS=
SID_SKIP_BOTS=
SID_SKIP_BOTS_SCORE=
# A secret: on Vercel, add it as a Sensitive environment variable (vercel env add SID_MODULE_SECRETS production --sensitive).
# Never commit a value.
# SID_MODULE_SECRETS={"ec":{"passphrase":"<openssl rand -hex 32>"}}
# Read only by the Vercel adapter:
# SID_PUBLIC_ORIGIN=     the origin of request URLs; defaults to the request's own (https on Vercel)
# SID_BEHIND_VERCEL=     false when not running on Vercel (next start on your own server): ignores Vercel's headers
