{
  "name": "@sharedid-edge/aws-lambda",
  "version": "0.1.0",
  "description": "Run SharedID Edge on AWS Lambda behind CloudFront (function URL or HTTP API, payload format 2.0)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "template.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "attw": "attw --pack . --profile esm-only --quiet || attw --pack . --profile esm-only",
    "bundle": "node scripts/bundle.mjs",
    "bundle:bowser": "node scripts/bundle.mjs --bowser"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/modules": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patmmccann/sharedid-edge.git",
    "directory": "packages/adapters/aws-lambda"
  },
  "sharedidEdge": {
    "kind": "adapter",
    "platform": "AWS (Lambda and CloudFront)",
    "summary": "A Lambda function behind a `/_sid/*` behaviour of your site's CloudFront distribution."
  }
}
