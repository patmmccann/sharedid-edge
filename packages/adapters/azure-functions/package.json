{
  "name": "@sharedid-edge/azure-functions",
  "version": "0.1.0",
  "description": "Run SharedID Edge on Azure Functions (Node.js v4 programming model) behind Azure Front Door",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "infra"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "attw": "attw --pack . --profile esm-only --quiet || attw --pack . --profile esm-only",
    "bundle": "node scripts/bundle.mjs",
    "bundle:bowser": "node scripts/bundle.mjs --bowser"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/modules": "0.1.0"
  },
  "devDependencies": {
    "@azure/functions": "^4.17.1",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patmmccann/sharedid-edge.git",
    "directory": "packages/adapters/azure-functions"
  },
  "peerDependencies": {
    "@azure/functions": "^4.17.1"
  },
  "peerDependenciesMeta": {
    "@azure/functions": {
      "optional": true
    }
  }
}
