{
  "name": "@sharedid-edge/cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "SharedID Edge as a Cloudflare Worker",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:bowser": "wrangler dev src/bowser.ts",
    "deploy": "wrangler deploy",
    "deploy:bowser": "wrangler deploy src/bowser.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:bowser": "wrangler deploy src/bowser.ts --dry-run --outdir dist-bowser",
    "types": "wrangler types --strict-vars=false worker-configuration.d.ts",
    "types:check": "wrangler types --strict-vars=false --check worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/modules": "0.1.0"
  },
  "devDependencies": {
    "@sharedid-edge/module-geo": "0.1.0",
    "wrangler": "^4.160.0",
    "@cloudflare/vitest-plugin": "^1.7.0"
  }
}
