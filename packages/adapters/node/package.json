{
  "name": "@sharedid-edge/node",
  "version": "0.1.0",
  "description": "Run SharedID Edge as a Node.js HTTP server, for local development, self-hosting and the conformance suite",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sharedid-edge-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/modules": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patmmccann/sharedid-edge.git",
    "directory": "packages/adapters/node"
  },
  "sharedidEdge": {
    "kind": "adapter",
    "platform": "Node.js (self-hosted)",
    "summary": "A Node.js server behind the web server or load balancer that serves your site."
  }
}
