{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    // Workers runtime types come from worker-configuration.d.ts (`npm run types`), not lib.dom or Node.
    "lib": ["ES2023"],
    // Wrangler bundles the worker; its generated types assume bundler resolution.
    "module": "ES2022",
    "moduleResolution": "Bundler"
  },
  "include": ["src", "worker-configuration.d.ts"]
}
