{
  "name": "@sharedid-edge/ip-ranges",
  "version": "0.1.0",
  "description": "SharedID Edge: compact IP range tables for IP database vendor modules, built from MMDB files at build time and looked up in memory",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "attw": "attw --pack . --profile esm-only --quiet || attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@sharedid-edge/core": "0.1.0",
    "@sharedid-edge/module-geo": "0.1.0",
    "@sharedid-edge/module-ip": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patmmccann/sharedid-edge.git",
    "directory": "packages/ip-ranges"
  }
}
