{
  "$schema": "../case-file.schema.json",
  "description": "The ec module with a passphrase under 32 bytes: it reports an error and sets nothing, but withdrawal (GPC, COPPA, opt-out, a TC string without Purpose 1) still deletes an existing ts-ec, because deletion needs no HMAC. Requests carry the client IP as X-Forwarded-For (Node.js and Lambda, SID_TRUST_PROXY) and CF-Connecting-IP (Workers).",
  "build": ["vendor-modules"],
  "config": {
    "SID_MODULES": "ec",
    "SID_MODULE_CONFIG": "{\"ec\":{\"domain\":\"example.com\"}}",
    "SID_TRUST_PROXY": "true",
    "SID_MODULE_SECRETS": "{\"ec\":{\"passphrase\":\"too-short\"}}"
  },
  "cases": [
    {
      "name": "reports an error and sets no ts-ec",
      "request": {
        "path": "/_sid/v1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "cookies": [
          {
            "name": "_pubcid"
          },
          {
            "name": "_pubcid_sv"
          }
        ],
        "onlyListedCookies": true,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "ec": {
                "status": "error"
              }
            }
          }
        }
      }
    },
    {
      "name": "still deletes ts-ec with Global Privacy Control",
      "request": {
        "path": "/_sid/v1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77",
          "sec-gpc": "1",
          "cookie": "ts-ec=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.Ab12z9"
        }
      },
      "expect": {
        "status": 200,
        "cookies": [
          {
            "name": "ts-ec",
            "value": "",
            "maxAge": 0,
            "domain": ".example.com",
            "httpOnly": true
          }
        ],
        "onlyListedCookies": true
      }
    },
    {
      "name": "still deletes ts-ec for a COPPA request",
      "request": {
        "path": "/_sid/v1?coppa=1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77",
          "cookie": "ts-ec=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.Ab12z9"
        }
      },
      "expect": {
        "status": 200,
        "cookies": [
          {
            "name": "ts-ec",
            "value": "",
            "maxAge": 0
          }
        ],
        "onlyListedCookies": true
      }
    },
    {
      "name": "still deletes ts-ec for a TC string without Purpose 1",
      "request": {
        "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77",
          "cookie": "ts-ec=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.Ab12z9"
        }
      },
      "expect": {
        "status": 200,
        "cookies": [
          {
            "name": "ts-ec",
            "value": "",
            "maxAge": 0
          }
        ],
        "onlyListedCookies": true
      }
    },
    {
      "name": "still deletes ts-ec on opt-out",
      "request": {
        "path": "/_sid/optout",
        "headers": {
          "cookie": "ts-ec=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.Ab12z9"
        }
      },
      "expect": {
        "status": 204,
        "cookies": [
          {
            "name": "_pubcid_optout",
            "value": "1"
          },
          {
            "name": "_pubcid",
            "maxAge": 0
          },
          {
            "name": "_pubcid_sv",
            "maxAge": 0
          },
          {
            "name": "ts-ec",
            "value": "",
            "maxAge": 0,
            "domain": ".example.com"
          }
        ],
        "onlyListedCookies": true
      }
    }
  ]
}
