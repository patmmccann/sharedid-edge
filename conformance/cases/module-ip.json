{
  "$schema": "../case-file.schema.json",
  "description": "The ip module (SID_MODULES=ip): the full client IP in the v1 payload's ortb2.device, or nothing (status empty) with GPC, COPPA, a US privacy opt-out, or under GDPR without opt-in to TCF Special Feature 1. It never sends a truncated address. Requests carry the client IP as both X-Forwarded-For (the Node.js target, and the Lambda target's CloudFront stand-in, run with SID_TRUST_PROXY) and CF-Connecting-IP (the Workers runtime). TC strings: CAAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAA opts in to Special Feature 1 and nothing else; CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA has no special features.",
  "config": { "SID_MODULES": "ip", "SID_TRUST_PROXY": "true" },
  "cases": [
    {
      "name": "doesn't run on /sync",
      "request": { "path": "/_sid/sync", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77" } },
      "expect": { "status": 200, "headers": { "content-type": "image/gif" }, "bodyLength": 43, "absentHeaders": ["x-sharedid-modules"] }
    },
    {
      "name": "adds an IPv4 client address as device.ip",
      "request": { "path": "/_sid/v1", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77" } },
      "expect": { "status": 200, "headers": { "cache-control": "no-store" }, "jsonIncludes": { "ortb2": { "device": { "ip": "192.0.2.77" } }, "ext": { "modules": { "ip": { "status": "ok" } } } } }
    },
    {
      "name": "adds an IPv6 client address as device.ipv6, in RFC 5952 form",
      "request": { "path": "/_sid/v1", "headers": { "x-forwarded-for": "2001:DB8:0:0:abcd::1", "cf-connecting-ip": "2001:DB8:0:0:abcd::1" } },
      "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "ipv6": "2001:db8::abcd:0:0:1" } } } }
    },
    {
      "name": "sends nothing with Global Privacy Control",
      "request": { "path": "/_sid/v1", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77", "sec-gpc": "1" } },
      "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "ip": { "status": "empty" } } } } }
    },
    {
      "name": "sends nothing for a COPPA request",
      "request": { "path": "/_sid/v1?coppa=1", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77" } },
      "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "ip": { "status": "empty" } } } } }
    },
    {
      "name": "sends nothing with a US privacy opt-out of sale",
      "request": { "path": "/_sid/v1?us_privacy=1YYN", "headers": { "x-forwarded-for": "2001:db8:abcd:12ff::1", "cf-connecting-ip": "2001:db8:abcd:12ff::1" } },
      "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "ip": { "status": "empty" } } } } }
    },
    {
      "name": "sends nothing when GDPR applies and there is no TC string",
      "request": { "path": "/_sid/v1?gdpr=1", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77" } },
      "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "ip": { "status": "empty" } } } } }
    },
    {
      "name": "sends nothing without opt-in to precise geolocation",
      "request": { "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77" } },
      "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "ip": { "status": "empty" } } } } }
    },
    {
      "name": "sends the full address with opt-in to precise geolocation",
      "request": { "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAA", "headers": { "x-forwarded-for": "192.0.2.77", "cf-connecting-ip": "192.0.2.77" } },
      "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "ip": "192.0.2.77" } } } }
    }
  ]
}
