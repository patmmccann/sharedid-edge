{
  "$schema": "../case-file.schema.json",
  "description": "The reflect module's per-cookie backups (SID_MODULES=reflect, keeper.mode \"per-cookie\"): _ga (400 days) and _gcl_au (90 days) are configured with domain example.com and restore: true, so each is backed up in its own HttpOnly cookie, _ga_backup and _gcl_au_backup, value as is, 400 days (keeper.maxAgeDays's default), Domain=.example.com (the cookie's own). The master keeper _sid_keep is read for migration and deleted; its value here is Buffer.from(JSON.stringify({ _ga: 'GA1.1.1234567890.1700000000', _gcl_au: '1.1.987654321.1700000000' })).toString('base64url').",
  "config": {
    "SID_MODULES": "reflect",
    "SID_MODULE_CONFIG": "{\"reflect\":{\"cookies\":[{\"name\":\"_ga\",\"maxAgeDays\":400,\"domain\":\"example.com\",\"restore\":true},{\"name\":\"_gcl_au\",\"maxAgeDays\":90,\"domain\":\"example.com\",\"restore\":true}],\"keeper\":{\"mode\":\"per-cookie\"}}}"
  },
  "cases": [
    {
      "name": "backs each restore cookie up in its own HttpOnly backup, and sets no keeper",
      "request": { "path": "/_sid/v1", "headers": { "cookie": "_gcl_au=1.1.987654321.1700000000; _ga=GA1.1.1234567890.1700000000" } },
      "expect": {
        "status": 200,
        "cookies": [
          { "name": "_pubcid" },
          { "name": "_pubcid_sv" },
          { "name": "_ga", "value": "GA1.1.1234567890.1700000000", "maxAge": 34560000, "domain": ".example.com", "httpOnly": false },
          { "name": "_gcl_au", "value": "1.1.987654321.1700000000", "maxAge": 7776000, "domain": ".example.com", "httpOnly": false },
          { "name": "_ga_backup", "value": "GA1.1.1234567890.1700000000", "maxAge": 34560000, "domain": ".example.com", "httpOnly": true },
          { "name": "_gcl_au_backup", "value": "1.1.987654321.1700000000", "maxAge": 34560000, "domain": ".example.com", "httpOnly": true }
        ],
        "onlyListedCookies": true
      }
    },
    {
      "name": "restores a missing cookie from its backup, on Prebid.js's sync call",
      "request": { "path": "/_sid/sync", "headers": { "cookie": "_ga_backup=GA1.1.1234567890.1700000000" } },
      "expect": {
        "status": 200,
        "cookies": [
          { "name": "_pubcid" },
          { "name": "_pubcid_sv" },
          { "name": "_ga", "value": "GA1.1.1234567890.1700000000", "maxAge": 34560000, "domain": ".example.com", "httpOnly": false },
          { "name": "_ga_backup", "value": "GA1.1.1234567890.1700000000", "httpOnly": true }
        ],
        "onlyListedCookies": true
      }
    },
    {
      "name": "migrates from the master keeper: restores from it, writes the backups, deletes the keeper",
      "request": { "path": "/_sid/v1", "headers": { "cookie": "_sid_keep=eyJfZ2EiOiJHQTEuMS4xMjM0NTY3ODkwLjE3MDAwMDAwMDAiLCJfZ2NsX2F1IjoiMS4xLjk4NzY1NDMyMS4xNzAwMDAwMDAwIn0" } },
      "expect": {
        "status": 200,
        "cookies": [
          { "name": "_pubcid" },
          { "name": "_pubcid_sv" },
          { "name": "_ga", "value": "GA1.1.1234567890.1700000000" },
          { "name": "_gcl_au", "value": "1.1.987654321.1700000000" },
          { "name": "_ga_backup", "value": "GA1.1.1234567890.1700000000", "httpOnly": true },
          { "name": "_gcl_au_backup", "value": "1.1.987654321.1700000000", "httpOnly": true },
          { "name": "_sid_keep", "value": "", "maxAge": 0 }
        ],
        "onlyListedCookies": true
      }
    },
    {
      "name": "deletes the backups when storage is denied (GPC), and leaves the cookies alone",
      "request": { "path": "/_sid/v1", "headers": { "cookie": "_ga=GA1.1.1234567890.1700000000; _ga_backup=GA1.1.1234567890.1700000000", "sec-gpc": "1" } },
      "expect": { "status": 200, "cookies": [{ "name": "_ga_backup", "value": "", "maxAge": 0 }], "onlyListedCookies": true }
    }
  ]
}
