{
  "$schema": "../case-file.schema.json",
  "description": "The encrypted-ip module (opt-in build) for Google only (SID_MODULE_CONFIG encrypted-ip.google): the client's IP address encrypted to Google's key (HPKE base mode, DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, AES-256-GCM), as the payload's eip.google for googletag.setConfig({ ipAddress }), never in ortb2; or nothing (status empty) with GPC, COPPA, a US privacy opt-out, the opt-out cookie, or under GDPR without opt-in to TCF Special Feature 1, as the ip module. The key has no keyFetched, so its age isn't checked. SID_MODULE_TIMEOUT_MS is 1000 so that a busy test machine's first Web Crypto call (about 15 ms cold on a laptop, against the default limit of 50) can't time out. Requests carry the client IP as both X-Forwarded-For (with SID_TRUST_PROXY) and CF-Connecting-IP (the Workers runtime). Every value is random (a fresh ephemeral key each time), so cases check its shape: unpadded base64url whose length gives 32 (enc) + the address's length + 16 (the AES-GCM tag) bytes: 192.0.2.77 is 10 characters, 58 bytes, 78 base64url characters; 2001:db8::abcd:0:0:1 (RFC 5952 form) is 20, 68 bytes, 91 characters. The keys are the recipient public keys (pkRm) of RFC 9180's published test vectors, for tests only: their private keys are public too. Prebid Server hosts here are single-label names (pbs-a, pbs-b) so that the dotted paths of jsonPatterns and jsonAbsent can name them. TC strings: CAAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAA opts in to Special Feature 1 and nothing else; CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA has no special features.",
  "build": [
    "vendor-modules"
  ],
  "config": {
    "SID_MODULES": "encrypted-ip",
    "SID_MODULE_CONFIG": "{\"encrypted-ip\":{\"google\":{\"key\":{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"X25519\",\"kid\":\"google-test\",\"x\":\"Qw9LmFlmUUWmsbonQCRIe9ZvA6LdV313U8aNfX0AwAw\"}]}}}}",
    "SID_TRUST_PROXY": "true",
    "SID_MODULE_TIMEOUT_MS": "1000"
  },
  "cases": [
    {
      "name": "doesn't run on /sync",
      "request": {
        "path": "/_sid/sync",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "image/gif"
        },
        "bodyLength": 43,
        "absentHeaders": [
          "x-sharedid-modules"
        ]
      }
    },
    {
      "name": "encrypts an IPv4 address for Google as eip.google, outside ortb2",
      "request": {
        "path": "/_sid/v1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "ok"
              }
            }
          }
        },
        "jsonPatterns": {
          "eip.google.value": "^[A-Za-z0-9_-]{78}$",
          "eip.google.kid": "^google-test$"
        },
        "jsonAbsent": [
          "ortb2.device.ip",
          "ortb2.device.ipv6",
          "eip.pbs",
          "eip.google.stale",
          "ext.modules.encrypted-ip.stale"
        ]
      }
    },
    {
      "name": "encrypts an IPv6 address, in RFC 5952 form",
      "request": {
        "path": "/_sid/v1",
        "headers": {
          "x-forwarded-for": "2001:DB8:0:0:abcd::1",
          "cf-connecting-ip": "2001:DB8:0:0:abcd::1"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "ok"
              }
            }
          }
        },
        "jsonPatterns": {
          "eip.google.value": "^[A-Za-z0-9_-]{91}$"
        },
        "jsonAbsent": [
          "ortb2.device.ip",
          "ortb2.device.ipv6"
        ]
      }
    },
    {
      "name": "sends nothing with Global Privacy Control",
      "request": {
        "path": "/_sid/v1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77",
          "sec-gpc": "1"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "empty"
              }
            }
          }
        },
        "jsonAbsent": [
          "eip"
        ]
      }
    },
    {
      "name": "sends nothing for a COPPA request",
      "request": {
        "path": "/_sid/v1?coppa=1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "empty"
              }
            }
          }
        },
        "jsonAbsent": [
          "eip"
        ]
      }
    },
    {
      "name": "sends nothing with a US privacy opt-out of sale",
      "request": {
        "path": "/_sid/v1?us_privacy=1YYN",
        "headers": {
          "x-forwarded-for": "2001:DB8:0:0:abcd::1",
          "cf-connecting-ip": "2001:DB8:0:0:abcd::1"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "empty"
              }
            }
          }
        },
        "jsonAbsent": [
          "eip"
        ]
      }
    },
    {
      "name": "sends nothing with the opt-out cookie",
      "request": {
        "path": "/_sid/v1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77",
          "cookie": "_pubcid_optout=1"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "empty"
              }
            }
          }
        },
        "jsonAbsent": [
          "eip"
        ]
      }
    },
    {
      "name": "sends nothing when GDPR applies and there is no TC string",
      "request": {
        "path": "/_sid/v1?gdpr=1",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "empty"
              }
            }
          }
        },
        "jsonAbsent": [
          "eip"
        ]
      }
    },
    {
      "name": "sends nothing without opt-in to precise geolocation",
      "request": {
        "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "empty"
              }
            }
          }
        },
        "jsonAbsent": [
          "eip"
        ]
      }
    },
    {
      "name": "encrypts the address with opt-in to precise geolocation",
      "request": {
        "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAA",
        "headers": {
          "x-forwarded-for": "192.0.2.77",
          "cf-connecting-ip": "192.0.2.77"
        }
      },
      "expect": {
        "status": 200,
        "jsonIncludes": {
          "ext": {
            "modules": {
              "encrypted-ip": {
                "status": "ok"
              }
            }
          }
        },
        "jsonPatterns": {
          "eip.google.value": "^[A-Za-z0-9_-]{78}$"
        },
        "jsonAbsent": [
          "ortb2.device.ip",
          "ortb2.device.ipv6"
        ]
      }
    }
  ]
}
