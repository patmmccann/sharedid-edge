{
  "$schema": "../case-file.schema.json",
  "description": "The geo module (SID_MODULES=geo): the platform location as ortb2.device.geo (OpenRTB 2.6), with the country as ISO 3166-1 alpha-3 and the region without its country prefix. Coarse fields (type, country, region, metro, utcoffset) are always sent; precise ones (city, zip, lat, lon) in full or not at all, left out with GPC, COPPA, a US privacy opt-out, or a TC string without opt-in to TCF Special Feature 1, or GDPR without a TC string. Requests describe the visitor's location with Cloudflare's visitor location headers (cf-ipcountry, cf-region-code, cf-ipcity, cf-postal-code, cf-metro-code, cf-iplatitude, cf-iplongitude, cf-timezone, cf-ipcontinent): the Node.js target reads them because it runs with SID_TRUST_PROXY, and the runner gives the Workers runtime the same values as request.cf. The time zones have no daylight saving time, so utcoffset is fixed. TC strings: CAAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAA opts in to Special Feature 1 and nothing else; CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA has no special features.",
  "config": { "SID_MODULES": "geo", "SID_TRUST_PROXY": "true" },
  "cases": [
    { "name": "returns the location as device.geo, precise fields included", "request": { "path": "/_sid/v1", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "headers": { "cache-control": "no-store" }, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420, "city": "Phoenix", "zip": "85004", "lat": 33.44838, "lon": -112.07404 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } } } },
    { "name": "strips the country prefix from the region and leaves out unknown fields", "request": { "path": "/_sid/v1", "headers": { "cf-ipcountry": "JP", "cf-region-code": "JP-13", "cf-ipcity": "Tokyo", "cf-timezone": "Asia/Tokyo", "cf-ipcontinent": "AS" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "JPN", "region": "13", "utcoffset": 540, "city": "Tokyo" } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.metro", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "ignores invalid coordinates and an unknown time zone", "request": { "path": "/_sid/v1", "headers": { "cf-ipcountry": "US", "cf-iplatitude": "north", "cf-iplongitude": "", "cf-timezone": "Mars/Olympus_Mons" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA" } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.lat", "ortb2.device.geo.lon", "ortb2.device.geo.utcoffset"] } },
    { "name": "returns nothing for a Tor request (country T1)", "request": { "path": "/_sid/v1", "headers": { "cf-ipcountry": "T1" } }, "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "geo": { "status": "empty" } } } }, "jsonAbsent": ["ortb2"] } },
    { "name": "returns nothing for an unknown country (XX)", "request": { "path": "/_sid/v1", "headers": { "cf-ipcountry": "XX" } }, "expect": { "status": 200, "jsonIncludes": { "ext": { "modules": { "geo": { "status": "empty" } } } }, "jsonAbsent": ["ortb2"] } },
    { "name": "sends only coarse fields with Global Privacy Control", "request": { "path": "/_sid/v1", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA", "sec-gpc": "1" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.city", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "sends only coarse fields for a COPPA request", "request": { "path": "/_sid/v1?coppa=1", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.city", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "sends only coarse fields with a US privacy opt-out of sale", "request": { "path": "/_sid/v1?us_privacy=1YYN", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.city", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "sends only coarse fields when GDPR applies and there is no TC string", "request": { "path": "/_sid/v1?gdpr=1", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.city", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "sends only coarse fields without opt-in to precise geolocation", "request": { "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.city", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "sends only coarse fields with an invalid TC string", "request": { "path": "/_sid/v1?gdpr_consent=not-a-tc-string", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } }, "jsonAbsent": ["ortb2.device.geo.city", "ortb2.device.geo.zip", "ortb2.device.geo.lat", "ortb2.device.geo.lon"] } },
    { "name": "sends the precise fields with opt-in to precise geolocation", "request": { "path": "/_sid/v1?gdpr=1&gdpr_consent=CAAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAA", "headers": { "cf-ipcountry": "US", "cf-region-code": "AZ", "cf-ipcity": "Phoenix", "cf-postal-code": "85004", "cf-metro-code": "753", "cf-iplatitude": "33.44838", "cf-iplongitude": "-112.07404", "cf-timezone": "America/Phoenix", "cf-ipcontinent": "NA" } }, "expect": { "status": 200, "jsonIncludes": { "ortb2": { "device": { "geo": { "type": 2, "country": "USA", "region": "AZ", "metro": "753", "utcoffset": -420, "city": "Phoenix", "zip": "85004", "lat": 33.44838, "lon": -112.07404 } } }, "ext": { "modules": { "geo": { "status": "ok" } } } } } }
  ]
}
