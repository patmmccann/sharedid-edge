{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedID Edge conformance case file",
  "type": "object",
  "required": ["description", "config", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "config": { "type": "object", "additionalProperties": { "type": "string" } },
    "build": {
      "description": "Build options the target must be built with. bowser: Bowser in the ua module (the Worker's and Lambda's Bowser builds; the Node.js server always has it). vendor-modules: every module in packages/vendor-modules/ added to the built-in ones (ec, and vendor modules). Not both.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["bowser", "vendor-modules"] }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "request", "expect"],
        "properties": {
          "name": { "type": "string" },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "method": { "type": "string" },
              "path": { "type": "string", "pattern": "^/" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "type": "integer" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "absentHeaders": { "type": "array", "items": { "type": "string" } },
              "bodyLength": { "type": "integer" },
              "json": {},
              "jsonIncludes": { "description": "The JSON body contains these values: objects match on the listed keys only, recursively; arrays and scalars exactly" },
              "jsonAbsent": { "type": "array", "items": { "type": "string" }, "description": "Dot-separated paths of object keys the JSON body must not have, e.g. ortb2.device.geo.lat" },
              "onlyListedCookies": { "type": "boolean" },
              "noCookies": { "type": "boolean" },
              "cookies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "value": { "type": "string" },
                    "valuePattern": { "type": "string" },
                    "maxAge": { "type": "integer" },
                    "sameSite": { "enum": ["Lax", "Strict", "None"] },
                    "path": { "type": "string" },
                    "domain": { "type": "string", "description": "The Domain attribute; an empty string for a host-only cookie" },
                    "httpOnly": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
