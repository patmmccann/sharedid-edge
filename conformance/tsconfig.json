{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src"],
  // The emulators use core's splitHeaders and their adapter's types: lambda-emulator.ts the Lambda events,
  // vercel-emulator.ts and azure-emulator.ts the handlers.
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/adapters/aws-lambda" },
    { "path": "../packages/adapters/vercel" },
    { "path": "../packages/adapters/azure-functions" }
  ]
}
