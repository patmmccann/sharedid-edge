# The sGTM tests' settings: cp .env.example .env (.env is gitignored). See README.md.

# Required: the server container's config string, from Tag Manager: Admin > Container Settings > Manually provision
# tagging server, for the container imported from gtm/container.json and published. It's a credential of the GTM
# container: keep it out of commits and logs. In CI it's the repository secret SGTM_CONTAINER_CONFIG.
CONTAINER_CONFIG=

# The test site's hostname and the preview server's. Both must resolve to 127.0.0.1: the tests map them in Chromium;
# for your own browser, add them to /etc/hosts. Change SID_COOKIE_DOMAIN with them.
SITE_HOST=www.sharedid.test
PREVIEW_HOST=sgtm-preview.sharedid.test

# The registrable domain Prebid.js writes _pubcid on, which SharedID Edge must match (SID_COOKIE_DOMAIN).
SID_COOKIE_DOMAIN=sharedid.test

# nginx's HTTPS port on 127.0.0.1.
HTTPS_PORT=8443

# How often the tagging server fetches the published container version, in seconds.
CONTAINER_REFRESH_SECONDS=60
